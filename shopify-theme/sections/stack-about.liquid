{{- 'stack-about.css' | asset_url | stylesheet_tag -}}

<section class="stack-about-section">
  <div class="sa-inner">

    <!-- Left: text -->
    <div class="sa-text">
      <div class="sa-eyebrow">About Pilr</div>
      <h2 class="sa-heading">A better way to<br>travel with your supplements.</h2>
      <p class="sa-body">Staying consistent shouldn't require full-size bottles, ziploc bags, or unnecessary containers. Pilr packs a full week's supply of your daily supplement stack into one seamless system. Designed to effortlessly move with you and keep your routine on track, no matter where you are.</p>
      <a href="{{ section.settings.cta_url }}" class="sa-btn">{{ section.settings.cta_label }}</a>
    </div>

    <!-- Right: stats -->
    <div class="sa-stats">
      <div class="sa-stat">
        <div class="sa-stat-num">3 Modular Pods</div>
        <div class="sa-stat-label">Pills, powders or both</div>
      </div>
      <div class="sa-stat">
        <div class="sa-stat-num">1 System</div>
        <div class="sa-stat-label">Add or remove pods</div>
      </div>
      <div class="sa-stat">
        <div class="sa-stat-num">TSA Compliant</div>
        <div class="sa-stat-label">Designed to Travel</div>
      </div>
      <div class="sa-stat">
        <div class="sa-stat-num">100% BPA-Free</div>
        <div class="sa-stat-label">Clean by design</div>
      </div>
    </div>

  </div>
</section>

{% schema %}
{
  "name": "Stack About",
  "tag": "div",
  "settings": [
    {
      "type": "url",
      "id": "cta_url",
      "label": "CTA button link",
      "default": "/"
    },
    {
      "type": "text",
      "id": "cta_label",
      "label": "CTA button text",
      "default": "Get early access"
    }
  ],
  "presets": [
    {
      "name": "Stack About"
    }
  ]
}
{% endschema %}
